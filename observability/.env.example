# 로컬 포트. 두 서비스 모두 127.0.0.1에만 바인딩된다.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Prometheus 데이터 보존 한도.
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=1GB

# Grafana 최초 관리자 계정. 실제 비밀번호로 변경한다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-start

# 백엔드 INTERNAL_CALL_TOKEN과 동일한 값이 담긴 파일 경로.
INTERNAL_CALL_TOKEN_FILE=./observability/secrets/internal-call-token
