# Docker 안의 k6가 로컬 Tomcat으로 요청할 때 사용하는 주소
BASE_URL=http://host.docker.internal:8080
TARGET_PATH=/api/health

# 로컬 테스트 계정의 Firebase ID Token. FirstFolio 로그인 응답이 발급하는 토큰이 아니다.
AUTH_TOKEN=

# localhost 계열이 아닌 주소는 명시적으로 true로 바꾸기 전까지 실행되지 않는다.
ALLOW_REMOTE_TARGET=false
ALLOW_STATE_CHANGES=false
K6_TEST_ID=local
K6_PROFILE=smoke

# 온보딩 준비 시 비우면 추천·장바구니 후보 ASSET 대단원을 모두 선택한다.
TEST_NICKNAME=
CURRICULUM_MAIN_CHAPTER_IDS=

# 기초 과정 완료 후 첫 상품 매수까지 수행할지 선택한다.
INITIAL_PORTFOLIO_BUY=false
INITIAL_PRODUCT_ID=
INITIAL_TRADE_AMOUNT=1000000

# smoke test
SMOKE_ITERATIONS=3

# load test: 기본 90초, 최대 10 VU
LOAD_STAGE_1_DURATION=10s
LOAD_STAGE_1_VUS=5
LOAD_STAGE_2_DURATION=30s
LOAD_STAGE_2_VUS=5
LOAD_STAGE_3_DURATION=10s
LOAD_STAGE_3_VUS=10
LOAD_STAGE_4_DURATION=30s
LOAD_STAGE_4_VUS=10
LOAD_RAMP_DOWN_DURATION=10s
REQUEST_INTERVAL_SECONDS=1

# 응답 시간 실패 기준
MAX_P95_MS=500
AUTH_MAX_P95_MS=2000
