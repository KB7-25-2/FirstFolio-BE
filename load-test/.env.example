# Docker 안의 k6가 로컬 Tomcat으로 요청할 때 사용하는 주소
BASE_URL=http://host.docker.internal:8080
TARGET_PATH=/api/health

# 인증 API를 테스트할 때만 실제 Bearer 토큰을 로컬 .env에 입력한다.
AUTH_TOKEN=

# localhost 계열이 아닌 주소는 명시적으로 true로 바꾸기 전까지 실행되지 않는다.
ALLOW_REMOTE_TARGET=false
K6_TEST_ID=local

# smoke test
SMOKE_ITERATIONS=3

# load test: 기본 90초, 최대 10 VU
LOAD_STAGE_1_DURATION=10s
LOAD_STAGE_1_VUS=5
LOAD_STAGE_2_DURATION=30s
LOAD_STAGE_2_VUS=5
LOAD_STAGE_3_DURATION=10s
LOAD_STAGE_3_VUS=10
LOAD_STAGE_4_DURATION=30s
LOAD_STAGE_4_VUS=10
LOAD_RAMP_DOWN_DURATION=10s
REQUEST_INTERVAL_SECONDS=1

# 응답 시간 실패 기준
MAX_P95_MS=500
