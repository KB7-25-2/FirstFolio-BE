DB_DRIVER=net.sf.log4jdbc.sql.jdbcapi.DriverSpy
DB_URL=jdbc:log4jdbc:mysql://localhost:3306/firstfolio_db?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=사용자이름
DB_PASSWORD=비밀번호

# Firebase 인증. 서비스 계정 JSON은 저장소에 넣지 않는다.
FIREBASE_PROJECT_ID=Firebase_프로젝트_ID
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
TERMS_OF_SERVICE_VERSION=적용중인_이용약관_버전
PRIVACY_POLICY_VERSION=적용중인_개인정보처리방침_버전

# 외부 데이터 소스 인증키 (OPEN_API_INVENTORY.md 참고). 실제 값은 커밋하지 않는다.
# 금융감독원 finlife — 예·적금 상품
FSS_FINLIFE_AUTH_KEY=
# 토스증권 Open API — 주식 시세 (OAuth2 Client Credentials)
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
# 공공데이터포털 — 채권 시세·기본정보, 주식 배당, ETF 시세 공통 단일 키
DATA_GO_KR_KEY=

# /internal/** 내부 배치 호출용 공유 토큰. 비어 있으면 내부 호출이 전부 거부된다.
# 로컬에서는 아무 값이나 넣고 요청 헤더 X-Internal-Token 에 같은 값을 보내면 된다.
INTERNAL_CALL_TOKEN=local-internal-token

# 쉼표로 구분하며 경로나 마지막 슬래시는 넣지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
