{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://firstfolio.org/schemas/lesson/1.0/lesson.schema.json",
  "title": "FirstFolio lesson content schema 1.0",
  "type": "object",
  "required": [
    "schemaVersion",
    "pages",
    "subChapterQuiz"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "subChapterQuiz": {
      "$ref": "#/$defs/subChapterQuiz"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonBlankText": {
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "<\\s*(?:/?\\s*[A-Za-z][^>]*|!--[\\s\\S]*--\\s*)>"
      }
    },
    "page": {
      "type": "object",
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "$ref": "#/$defs/nonBlankText"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      },
      "additionalProperties": false
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/conclusionBlock"
        },
        {
          "$ref": "#/$defs/definitionBlock"
        },
        {
          "$ref": "#/$defs/learnMoreBlock"
        }
      ]
    },
    "textBlock": {
      "type": "object",
      "required": [
        "type",
        "content"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "content": {
          "$ref": "#/$defs/nonBlankText"
        }
      },
      "additionalProperties": false
    },
    "conclusionBlock": {
      "type": "object",
      "required": [
        "type",
        "formula"
      ],
      "properties": {
        "type": {
          "const": "conclusion"
        },
        "formula": {
          "$ref": "#/$defs/nonBlankText"
        },
        "note": {
          "$ref": "#/$defs/nonBlankText"
        }
      },
      "additionalProperties": false
    },
    "definitionBlock": {
      "type": "object",
      "required": [
        "type",
        "term",
        "body"
      ],
      "properties": {
        "type": {
          "const": "definition"
        },
        "term": {
          "$ref": "#/$defs/nonBlankText"
        },
        "body": {
          "$ref": "#/$defs/nonBlankText"
        }
      },
      "additionalProperties": false
    },
    "learnMoreBlock": {
      "type": "object",
      "required": [
        "type",
        "modal"
      ],
      "properties": {
        "type": {
          "const": "learn_more"
        },
        "chipLabel": {
          "$ref": "#/$defs/nonBlankText"
        },
        "chipSubtitle": {
          "$ref": "#/$defs/nonBlankText"
        },
        "modal": {
          "$ref": "#/$defs/learnMoreModal"
        }
      },
      "additionalProperties": false
    },
    "learnMoreModal": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonBlankText"
        },
        "example": {
          "$ref": "#/$defs/nonBlankText"
        },
        "body": {
          "$ref": "#/$defs/nonBlankText"
        },
        "footer": {
          "$ref": "#/$defs/nonBlankText"
        }
      },
      "additionalProperties": false
    },
    "subChapterQuiz": {
      "type": "object",
      "required": [
        "questionIds"
      ],
      "properties": {
        "questionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "additionalProperties": false
    }
  }
}
