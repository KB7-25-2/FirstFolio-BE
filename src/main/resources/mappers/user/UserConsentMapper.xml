<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.firstfolio.user.mapper.UserConsentMapper">

    <insert id="insert"
            parameterType="org.firstfolio.user.domain.UserConsent">
        INSERT INTO user_consents (
            user_id,
            consent_type,
            policy_version,
            is_agreed,
            occurred_at
        ) VALUES (
            #{userId},
            #{consentType},
            #{policyVersion},
            #{agreed},
            #{occurredAt}
        )
    </insert>

</mapper>
