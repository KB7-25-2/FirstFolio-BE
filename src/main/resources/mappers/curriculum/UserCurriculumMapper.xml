<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.firstfolio.curriculum.mapper.UserCurriculumMapper">

    <resultMap id="userCurriculumItemResultMap"
               type="org.firstfolio.curriculum.domain.UserCurriculumItem">
        <id property="curriculumItemId" column="curriculum_item_id" />
        <result property="userId" column="user_id" />
        <result property="mainChapterId" column="main_chapter_id" />
        <result property="displayOrder" column="display_order" />
        <result property="sourceType" column="source_type" />
        <result property="status" column="status" />
        <result property="confirmedAt" column="confirmed_at" />
        <result property="completedAt" column="completed_at" />
    </resultMap>

    <select id="findUserIdForUpdate" resultType="java.lang.Long">
        SELECT user_id
        FROM users
        WHERE user_id = #{userId}
        FOR UPDATE
    </select>

    <select id="findActiveByUserId"
            resultMap="userCurriculumItemResultMap">
        SELECT
            curriculum_item_id,
            user_id,
            main_chapter_id,
            display_order,
            source_type,
            status,
            confirmed_at,
            completed_at
        FROM user_curriculum_items
        WHERE user_id = #{userId}
          AND status = 'ACTIVE'
        ORDER BY display_order, curriculum_item_id
    </select>

    <insert id="insertAll">
        INSERT INTO user_curriculum_items (
            user_id,
            main_chapter_id,
            display_order,
            source_type,
            status,
            confirmed_at,
            completed_at
        ) VALUES
        <foreach collection="items" item="item" separator=",">
            (
                #{userId},
                #{item.mainChapterId},
                #{item.displayOrder},
                #{item.sourceType},
                'ACTIVE',
                #{confirmedAt},
                NULL
            )
        </foreach>
    </insert>

</mapper>
