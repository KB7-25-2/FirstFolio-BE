<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.firstfolio.simulation.mapper.ProductPriceMapper">

    <resultMap id="productPriceResult" type="org.firstfolio.simulation.domain.ProductPrice">
        <id property="productPriceId" column="product_price_id"/>
        <result property="productId" column="product_id"/>
        <result property="price" column="price"/>
        <result property="referenceAt" column="reference_at"/>
        <result property="sourceType" column="source_type"/>
        <result property="generationKey" column="generation_key"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- idx_product_prices_latest (product_id, reference_at DESC)를 그대로 탄다. -->
    <select id="findLatestByProductId" resultMap="productPriceResult">
        SELECT product_price_id,
               product_id,
               price,
               reference_at,
               source_type,
               generation_key,
               created_at
        FROM product_prices
        WHERE product_id = #{productId}
        ORDER BY reference_at DESC
        LIMIT 1
    </select>

    <!--
        상품별 최신 시점을 먼저 구하고 그 행만 다시 읽는다.
        uq_product_prices_product_time (product_id, reference_at) 덕분에 상품당 한 행만 나온다.
    -->
    <select id="findLatestByProductIds" resultMap="productPriceResult">
        SELECT p.product_price_id,
               p.product_id,
               p.price,
               p.reference_at,
               p.source_type,
               p.generation_key,
               p.created_at
        FROM product_prices p
                 JOIN (
            SELECT product_id, MAX(reference_at) AS reference_at
            FROM product_prices
            WHERE product_id IN
            <foreach item="productId" collection="productIds" open="(" separator="," close=")">
                #{productId}
            </foreach>
            GROUP BY product_id
        ) latest ON latest.product_id = p.product_id
            AND latest.reference_at = p.reference_at
    </select>

    <!-- 오늘 마감 후 저장된 종가가 이미 있는지. 상품을 가리지 않아 인덱스를 타지 않지만
         하루 15행짜리 테이블이고 재시작 직후 한 번만 부른다. -->
    <select id="countSavedSince" resultType="int">
        SELECT COUNT(*)
        FROM product_prices
        WHERE reference_at >= #{from}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="productPriceId">
        INSERT INTO product_prices (
            product_id,
            price,
            reference_at,
            source_type,
            generation_key,
            created_at
        ) VALUES (
            #{productId},
            #{price},
            #{referenceAt},
            #{sourceType},
            #{generationKey},
            #{createdAt}
        )
    </insert>

</mapper>
